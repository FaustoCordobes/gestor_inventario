# Copiá este archivo como .env y completá tus propios valores.
# El archivo .env NO se sube a GitHub: nunca pongas claves reales acá.
SECRET_KEY=cambiame-por-una-frase-larga-y-secreta
DATABASE_URL=sqlite:///inventario.db

# Login con Google: se obtienen en Google Cloud Console > Credenciales.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
